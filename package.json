{
	"name": "terai",
	"version": "0.0.0",
	"private": true,
	"description": "A modern localization framework for Javascript",
	"keywords": [],
	"author": "Hugo Corta <corta.hugo@gmail.com>",
	"license": "MIT",
	"packageManager": "pnpm@10.22.0",
	"scripts": {
		"dev": "turbo dev --filter='./packages/**'",
		"build": "turbo build --filter='./packages/**'",
		"test": "pnpm build && vitest run packages",
		"test:dev": "vitest packages",
		"test:coverage": "pnpm build && vitest run packages --coverage",
		"clean": "pnpm -r --parallel exec rimraf node_modules dist .turbo && rimraf node_modules .turbo",
		"prepare": "husky",
		"release": "changeset publish",
		"release-dev": "changeset version --snapshot dev && changeset publish --tag dev",
		"postversion": "git push && git push --tags"
	},
	"dependencies": {
		"@legendapp/state": "^2.1.15",
		"chalk": "^6.0.1",
		"next": "^16.4.2",
		"outdent": "^0.8.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^3.0.3",
		"@types/node": "^26.6.5",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitest/coverage-v8": "^5.0.5",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"rimraf": "^6.1.3",
		"tsdown": "^0.23.1",
		"turbo": "^2.11.9",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
