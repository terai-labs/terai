		"@terai/ts": "workspace:*"
	},
	"devDependencies": {
		"@babel/core": "^8",
		"@babel/plugin-transform-runtime": "^8",
		"@babel/preset-env": "^8",
		"@babel/preset-react": "^8",
		"@rollup/plugin-alias": "^6",
		"@rollup/plugin-babel": "^7",
		"@rollup/plugin-commonjs": "^29",
		"@rollup/plugin-node-resolve": "^16",
		"@rollup/plugin-terser": "^1",
		"@rollup/plugin-typescript": "^12",
		"@terai/types": "workspace:*",
		"rollup": "^4.64.8",
		"rollup-plugin-preserve-directives": "^0.4.0"
	},
	"peerDependencies": {
		"next": "^15 || ^16",
		"react": "^19"
	}
