{
	"name": "@terai/next",
	"description": "Terai for Next.js",
	"version": "0.0.16",
	"main": "dist/index.cjs",
	"module": "dist/index.mjs",
	"require": "dist/index.js",
	"types": "dist/index.d.ts",
	"author": "Hugo Corta <corta.hugo@gmail.com>",
	"scripts": {
		"dev": "rollup -c -w",
		"build": "rollup -c"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@terai/formatter": "workspace:*",
