{
	"name": "@terai/transformer",
	"description": "terai core transformer",
	"version": "0.0.16",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/terai-labs/terai.git",
		"directory": "packages/transformer"
	},
	"author": "Hugo Corta <corta.hugo@gmail.com>",
	"scripts": {
		"dev": "tsdown --format=esm --no-dts --watch",
		"build": "tsdown"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"dependencies": {
		"@terai/utils": "workspace:*",
		"typescript": "~6.0.3"
	},
	"devDependencies": {
		"@terai/types": "workspace:*"
	}
}
