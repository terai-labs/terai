{
	"name": "@terai/dev",
	"version": "0.0.16",
	"description": "The user-facing package for Terai",
	"engines": {
		"node": ">=22.13.0"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/terai-labs/terai.git",
		"directory": "packages/dev"
	},
	"private": false,
	"author": "Hugo Corta <corta.hugo@gmail.com>",
	"bin": {
		"terai": "bin.js"
	},
	"scripts": {
		"dev": "tsdown --format=esm --no-dts --watch",
		"build": "tsdown"
	},
	"files": [
		"bin.js",
		"dist"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"dependencies": {
		"@inquirer/prompts": "^8.7.3",
		"@terai/extractor": "workspace:*",
		"@terai/runtime": "workspace:*",
		"@terai/translator": "workspace:*",
		"@terai/types": "workspace:*",
		"@terai/utils": "workspace:*",
		"cac": "^7.1.0",
		"dotenv": "^18.0.8",
		"inquirer": "^14.2.3",
		"kleur": "^4.1.5",
		"perfect-debounce": "^2.1.0",
		"preferred-pm": "^5.0.1"
	},
	"devDependencies": {
		"@terai/generator": "workspace:*",
		"@terai/logger": "workspace:*",
		"@types/update-notifier": "^6.0.8",
		"update-notifier": "^7.3.1"
	}
}
