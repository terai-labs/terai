{
	"name": "@terai/runtime",
	"version": "0.0.19",
	"description": "terai node utilities",
	"engines": {
		"node": ">=22.13.0"
	},
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/terai-labs/terai.git",
		"directory": "packages/runtime"
	},
	"author": "Hugo Corta <corta.hugo@gmail.com>",
	"scripts": {
		"dev": "tsdown --format=esm --no-dts --watch",
		"build": "tsdown"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"dependencies": {
		"@terai/logger": "workspace:*",
		"bundle-n-require": "^1.1.2",
		"chokidar": "^5.0.0",
		"fast-glob": "^3.3.3",
		"fs-extra": "^11.4.1",
		"look-it-up": "^2.1.0",
		"outdent": "^0.8.0",
		"pathe": "^2.0.3",
		"picomatch": "^4.0.7"
	},
	"devDependencies": {
		"@terai/types": "workspace:*",
		"@types/fs-extra": "^11.0.4",
		"@types/picomatch": "^4.0.3"
	}
}
