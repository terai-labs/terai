{
	"name": "@terai/translator",
	"description": "terai core translator",
	"version": "0.0.19",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/terai-labs/terai.git",
		"directory": "packages/translator"
	},
	"author": "Hugo Corta <corta.hugo@gmail.com>",
	"scripts": {
		"dev": "tsdown --format=esm --no-dts --watch",
		"build": "tsdown"
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./translators": {
			"import": {
				"types": "./dist/translators/index.d.mts",
				"default": "./dist/translators/index.mjs"
			},
			"require": {
				"types": "./dist/translators/index.d.cts",
				"default": "./dist/translators/index.cjs"
			}
		}
	},
	"peerDependencies": {
		"@aws-sdk/client-translate": "^3",
		"@google-cloud/translate": "^8 || ^9 || ^10",
		"ai": "^5 || ^6 || ^7",
		"deepl-node": "^1",
		"zod": "^4"
	},
	"devDependencies": {
		"@aws-sdk/client-translate": "^3.1152.0",
		"@google-cloud/translate": "^10.3.0",
		"@terai/runtime": "workspace:*",
		"@terai/types": "workspace:*",
		"@terai/utils": "workspace:*",
		"ai": "^7.0.143",
		"deepl-node": "^1.28.1",
		"zod": "^4.6.7"
	}
}
